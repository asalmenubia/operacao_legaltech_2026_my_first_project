# Copy this file to .env and replace the values for your local PostgreSQL server.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mydb
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/mydb

# Private messaging service (never put credentials in site/ or Git).
OFFICE_TIMEZONE=Europe/Lisbon
COMMUNICATIONS_LIVE_SEND=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
# Dedicated, filtered inbound mailbox folder. App-password authentication where supported.
IMAP_HOST=
IMAP_PORT=993
IMAP_FOLDER=LegalTech
SMTP_HOST=
SMTP_PORT=465
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
# Enable acknowledgments only after mailbox spam/authentication filtering is configured.
EMAIL_AUTO_ACK=false
